# Contrato de configuração PROPOSTO. Nenhuma aplicação lê este arquivo ainda.
# Adaptar nomes e validação quando a stack for escolhida.
# Somente exemplos locais fictícios; nunca usar estes valores em produção.

APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
